# Product API key clients send as: Authorization: Bearer <RAG_GATE_API_KEY>
RAG_GATE_API_KEY=replace-with-a-long-random-secret

# TypeSafe System One (never commit a real key)
# https://docs.typesafe.ai
TYPESAFE_API_KEY=

# Optional TypeSafe overrides (SDK defaults are fine for v0)
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=

# Set to 1 to score chunks locally without calling TypeSafe
MOCK_TYPESAFE=0

# HTTP listen port
PORT=3000
