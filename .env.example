# Product API key. Clients send: Authorization: Bearer <value>
# Leave empty here. Set a real value only in a local .env (never commit it).
RAG_GATE_API_KEY=

# TypeSafe System One. Leave empty here. Set only in a local .env.
# https://docs.typesafe.ai
TYPESAFE_API_KEY=

# Optional TypeSafe overrides (SDK defaults are fine for v0)
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=

# Set to 1 to score chunks locally without calling TypeSafe
MOCK_TYPESAFE=0

# HTTP listen port
PORT=3000
